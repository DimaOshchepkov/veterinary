<!DOCTYPE html>
<html>
    <head>
        <style>
            .turbo-progress-bar {
                position: fixed;
                display: block;
                height: 3px;
                background: #111827;
                top: 0;
                left: 0;
                z-index: 9999;
                transition: width 300ms ease-out, opacity 150ms 150ms ease-in;
            }
        </style>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">


        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="min-h-screen flex flex-col bg-gray-50">


    <header class="bg-indigo-600 text-white shadow-lg">
        <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div  class="text-2xl font-bold">Ветеринарная клиника</div>
            <div class="space-x-4">
                <a href="{{ path('app_appointment_index') }}" class="hover:text-indigo-200">Услуги</a>

                {% if app.user %}
                    <a href="{{ path('app_pet_index') }}" class="hover:text-indigo-200">Питомцы</a>
                    <a href="{{ path('app_logout') }}" class="hover:text-indigo-200">Выход</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="hover:text-indigo-200">Вход</a>
                    <a href="{{ path('app_register') }}" class="hover:text-indigo-200">Регистрация</a>
                {% endif %}
            </div>
        </nav>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-gray-800 text-white py-6 mt-auto">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; {{ "now"|date("Y") }} Ветеринарная клиника. Все права защищены.</p>
        </div>
    </footer>

    </body>
</html>
