{# templates/components/data_table.html.twig #}
{% set headers = headers|default([]) %}
{% set rows = rows|default([]) %}
{% set emptyMessage = emptyMessage|default('Список пуст') %}
{% set emptyAction = emptyAction|default(null) %}
{% set pagination = pagination|default(null) %}
{% set route = route|default(null) %}
{% set queryParams = queryParams|default({}) %}

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    {% if rows is empty %}
        <div class="flex flex-col items-center justify-center py-12 text-center">
            <p class="text-sm text-gray-500">{{ emptyMessage }}</p>
            {% if emptyAction %}
                <a href="{{ emptyAction.url }}" class="mt-4 inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                    {{ emptyAction.label }}
                </a>
            {% endif %}
        </div>
    {% else %}
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
            <tr>
                {% for header in headers %}
                    <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider {{ header.class|default('') }}">
                        {{ header.label }}
                    </th>
                {% endfor %}
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
            {% for row in rows %}
                {% block table_row %}
                    <tr class="hover:bg-gray-50">
                        <td colspan="{{ headers|length }}" class="px-4 py-4 text-sm text-gray-500 text-center">
                            Переопределите блок table_row в вашем шаблоне
                        </td>
                    </tr>
                {% endblock %}
            {% endfor %}
            </tbody>
        </table>

        {% if pagination and pagination.haveToPaginate() %}
            {% include 'components/_pagination.html.twig' with {
                pagination: pagination,
                route: route,
                queryParams: queryParams
            } %}
        {% endif %}
    {% endif %}
</div>
