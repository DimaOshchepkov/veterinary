{#
Использование:
{% include 'components/delete_button.html.twig' with {
    url: path('app_pet_delete', {'id': pet.id}),
    name: pet.name
} %}
#}

<button type="button"
        data-action="click->delete-modal#open"
        data-url="{{ url }}"
        data-name="{{ name }}"
        data-token="{{ csrf_token('submit') }}"
        class="text-red-600 hover:text-red-800 hover:underline">
    {{ label|default('Удалить') }}
</button>
