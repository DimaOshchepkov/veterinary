{% for type in types|default(['success', 'error', 'warning', 'info']) %}
    {% for message in app.flashes(type) %}

        {% if type == 'success' %}
            {% set cls = 'border-green-200 bg-green-50 text-green-800' %}
        {% elseif type == 'error' %}
            {% set cls = 'border-red-200 bg-red-50 text-red-800' %}
        {% elseif type == 'warning' %}
            {% set cls = 'border-yellow-200 bg-yellow-50 text-yellow-800' %}
        {% else %}
            {% set cls = 'border-blue-200 bg-blue-50 text-blue-800' %}
        {% endif %}

        <div class="mb-4 flex items-center justify-between rounded-md border px-4 py-3 text-sm {{ cls }}">
            <span>{{ message }}</span>
            <button type="button" onclick="this.parentElement.remove()" class="ml-4 text-xl leading-none opacity-60 hover:opacity-100">
                &times;
            </button>
        </div>
    {% endfor %}
{% endfor %}
