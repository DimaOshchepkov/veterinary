{% use 'form_div_layout.html.twig' %}


{% block form_row %}
    <div class="space-y-1.5">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}


{% block form_label %}
    {% if label is not same as(false) %}
        {% if label is empty %}
            {% set label = name|humanize %}
        {% endif %}
        <label for="{{ id }}" class="block text-sm font-medium text-gray-700 mb-1.5">
            {{ label|trans(label_translation_parameters, translation_domain) }}
        </label>
    {% endif %}
{% endblock %}


{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-md border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900 sm:text-sm px-3 py-2.5 border transition-colors placeholder-gray-400')|trim
    }) %}
    <input type="{{ type }}" {{ block('widget_attributes') }}{% if value is not empty %} value="{{ value }}"{% endif %} />
{% endblock %}


{% block checkbox_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900 cursor-pointer')|trim
    }) %}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{% endblock %}


{% block checkbox_row %}
    <div class="flex items-start">
        <div class="flex items-center h-5">
            {{ form_widget(form) }}
        </div>
        <div class="ml-3 text-sm">
            {{ form_label(form, null, {'label_attr': {'class': 'font-medium text-gray-700 cursor-pointer select-none'}}) }}
        </div>
    </div>
    {{ form_errors(form) }}
{% endblock %}


{% block textarea_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' block w-full rounded-md border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900 sm:text-sm px-3 py-2.5 border transition-colors placeholder-gray-400')|trim
    }) %}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock %}


{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1.5 text-xs text-red-500 list-none pl-0 space-y-1">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}


{% block button_widget %}
    {% set attr = attr|merge({
        'class': (attr.class|default('') ~ ' w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-all duration-200')|trim
    }) %}
    <button type="{{ type|default('button') }}" {{ block('button_attributes') }}>
        {{ label|trans(label_translation_parameters, translation_domain) }}
    </button>
{% endblock %}
