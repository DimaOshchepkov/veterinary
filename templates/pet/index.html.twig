{% extends 'base.html.twig' %}

{% block title %}Питомцы{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-4 py-8" data-controller="delete-modal">
        {% include 'components/flash_messages.html.twig' %}

        <div class="flex items-center justify-between mb-6">
            <h1 class="text-2xl font-semibold text-gray-900">Мои питомцы</h1>
            <a href="{{ path('app_pet_new') }}"
               class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                Добавить питомца
            </a>
        </div>

        {% embed 'components/data_table.html.twig' with {
            headers: [
                {label: '№', class: 'w-12'},
                {label: 'Кличка'},
                {label: 'Вид'},
                {label: 'Пол'},
                {label: 'Действия', class: 'text-right'}
            ],
            rows: pets,
            emptyMessage: 'У вас пока нет питомцев.',
            emptyAction: {url: path('app_pet_new'), label: 'Добавить питомца'},
            route: 'app_pet_index',
            queryParams: app.request.query.all()
        } %}
            {% block table_row %}
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-500">{{ loop.index }}</td>
                    <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ row.name }}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{ row.speciesLabel }}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">{{ row.genderLabel }}</td>
                    <td class="px-4 py-3 text-right text-sm space-x-2">
                        <a href="{{ path('app_pet_edit', {'id': row.id}) }}"
                           class="text-gray-700 hover:text-gray-900 hover:underline">
                            Редактировать
                        </a>
                        {% include 'components/delete_button.html.twig' with {
                            url: path('app_pet_delete', {'id': row.id}),
                            name: row.name
                        } %}
                    </td>
                </tr>
            {% endblock %}
        {% endembed %}

        {% include 'components/confirm_delete_modal.html.twig' %}
    </div>
{% endblock %}
