{% extends 'base.html.twig' %}

{% block title %}Питомцы{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-4 py-8" data-controller="delete-modal">

        {% for message in app.flashes('success') %}
            <div class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        {% if pets is empty %}
            <div class="flex flex-col items-center justify-center py-24 text-center">
                <h2 class="text-xl font-medium text-gray-900">У вас пока нет питомцев</h2>
                <p class="mt-2 text-sm text-gray-500">Добавьте первого питомца, чтобы начать работу.</p>
                <a href="{{ path('app_pet_new') }}"
                   class="mt-6 inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                    Добавить питомца
                </a>
            </div>
        {% else %}
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-2xl font-semibold text-gray-900">Мои питомцы</h1>
                <a href="{{ path('app_pet_new') }}"
                   class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">
                    Добавить питомца
                </a>
            </div>

            <div class="overflow-hidden rounded-lg border border-gray-200">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12">
                            №
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Кличка
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Вид
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Пол
                        </th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Действия
                        </th>
                    </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                    {% for pet in pets %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 text-sm text-gray-500">{{ loop.index }}</td>
                            <td class="px-4 py-3 text-sm font-medium text-gray-900">{{ pet.name }}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">{{ pet.speciesLabel }}</td>
                            <td class="px-4 py-3 text-sm text-gray-600">{{ pet.genderLabel }}</td>
                            <td class="px-4 py-3 text-right text-sm space-x-2">
                                <a href="{{ path('app_pet_edit', {'id': pet.id}) }}"
                                   class="text-gray-700 hover:text-gray-900 hover:underline">
                                    Редактировать
                                </a>
                                {% include 'components/delete_button.html.twig' with {
                                    url: path('app_pet_delete', {'id': pet.id}),
                                    name: pet.name
                                } %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% include 'components/confirm_delete_modal.html.twig' %}
    </div>
{% endblock %}
