{% extends 'base.html.twig' %}

{% block title %}Вход в систему{% endblock %}

{% block body %}
    {% set content %}
        {% if error %}
            {% include 'components/alert.html.twig' with {
                message: error.messageKey|trans(error.messageData, 'security'),
                type: 'red'
            } %}
        {% endif %}

        {% if app.user %}
            {% include 'components/alert.html.twig' with {
                message: 'Вы уже вошли как ' ~ app.user.userIdentifier ~ '. <a href="' ~ path('app_logout') ~ '" class="font-medium underline">Выйти</a>',
                type: 'blue',
                center: true
            } %}
        {% endif %}

        <form method="post" class="space-y-5">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                <input type="email"
                       value="{{ last_username }}"
                       name="_username"
                       id="username"
                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900 sm:text-sm px-3 py-2.5 border transition-colors placeholder-gray-400"
                       autocomplete="email"
                       required
                       autofocus>
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1.5">Пароль</label>
                <input type="password"
                       name="_password"
                       id="password"
                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-gray-900 focus:ring-gray-900 sm:text-sm px-3 py-2.5 border transition-colors placeholder-gray-400"
                       autocomplete="current-password"
                       required>
            </div>

            <div class="flex items-start">
                <div class="flex items-center h-5">
                    <input type="checkbox"
                           name="_remember_me"
                           id="_remember_me"
                           class="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900 cursor-pointer">
                </div>
                <div class="ml-3 text-sm">
                    <label for="_remember_me" class="font-medium text-gray-700 cursor-pointer select-none">
                        Запомнить меня
                    </label>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="pt-2">
                <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-all duration-200">
                    Войти
                </button>
            </div>
        </form>
    {% endset %}

    {% set footer %}
        <p class="mt-8 text-center text-sm text-gray-500">
            Нет аккаунта?
            <a href="{{ path('app_register') }}" class="font-medium text-gray-900 hover:text-gray-700 transition-colors underline underline-offset-4">
                Зарегистрироваться
            </a>
        </p>
    {% endset %}

    {% include 'components/form_card.html.twig' with {
        title: 'Вход в систему',
        content: content,
        footer: footer
    } %}
{% endblock %}
